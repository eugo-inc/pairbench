---
// SPDX-License-Identifier: Apache-2.0
// Copyright (c) 2026, Eugo, Inc.
// The page a host serves for an address that has no page: dist/404.html. It asks search
// engines not to index it, since it stands for no page of its own.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const home = `${import.meta.env.BASE_URL}latest/`;
const index = `${import.meta.env.BASE_URL}latest/llms.txt`;
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: 'No page of the pairbench documentation has this address.',
    template: 'splash',
    pagefind: false,
    head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } }],
  }}
>
  <p>
    No page of the pairbench documentation has this address. Start from the
    <a href={home}>documentation home</a>, use the search, or read the
    <a href={index}>list of every page</a>.
  </p>
</StarlightPage>
